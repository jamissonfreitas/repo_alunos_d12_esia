+        self.assertEqual(pedido["status"], "pago")
+        self.assertEqual(estoque.saldos, {"A": 0, "B": 1})
+        self.assertEqual(repo.todos(), [pedido])
+        self.assertEqual(gateway.cobrancas, [(pedido["total"], "tok_ok")])
